
'use client'
import { useEffect, useState, useCallback } from 'react'
import { supabase } from '@/lib/supabase'

const fmt = (n: number) => new Intl.NumberFormat('ru-KZ', { maximumFractionDigits: 0 }).format(n)

type Goal = {
  id: string
  name: string
  icon: string
  target_amount: number
  current_amount: number
  deadline: string | null
  color: string
  is_active: boolean
  notes: string | null
}

type SavingsTx = {
  id: string
  goal_id: string
  amount: number
  type: 'deposit' | 'withdrawal'
  note: string | null
  date: string
}

const ICONS = ['🎯','🛡️','🏖️','🚗','🏠','📱','💍','🎓','👶','💊','✈️','🎮','💰','🏦']
const COLORS = ['#22c55e','#3b5bdb','#06b6d4','#f97316','#a855f7','#eab308','#ef4444','#ec4899']

export default function Savings() {
  const [goals, setGoals] = useState<Goal[]>([])
  const [showAdd, setShowAdd] = useState(false)
  const [showDeposit, setShowDeposit] = useState<Goal | null>(null)
  const [showDetail, setShowDetail] = useState<Goal | null>(null)
  const [txHistory, setTxHistory] = useState<SavingsTx[]>([])
  const [form, setForm] = useState({ name: '', icon: '🎯', target_amount: '', deadline: '', color: '#3b5bdb', notes: '' })
  const [depositForm, setDepositForm] = useState({ amount: '', type: 'deposit' as 'deposit' | 'withdrawal', note: '' })
  const [saving, setSaving] = useState(false)

  const load = useCallback(async () => {
    const { data } = await supabase.from('savings_goals').select('*').eq('is_active', true).order('created_at')
    setGoals(data || [])
  }, [])

  useEffect(() => { load() }, [load])

  const loadHistory = async (goalId: string) => {
    const { data } = await supabase.from('savings_transactions').select('*').eq('goal_id', goalId).order('date', { ascending: false }).limit(20)
    setTxHistory(data || [])
  }

  const openDetail = async (goal: Goal) => {
    setShowDetail(goal)
    await loadHistory(goal.id)
  }

  const addGoal = async () => {
    if (!form.name) return
    setSaving(true)
    await supabase.from('savings_goals').insert({
      name: form.name,
      icon: form.icon,
      target_amount: parseFloat(form.target_amount) || 0,
      deadline: form.deadline || null,
      color: form.color,
      notes: form.notes || null,
    })
    setForm({ name: '', icon: '🎯', target_amount: '', deadline: '', color: '#3b5bdb', notes: '' })
    setShowAdd(false)
    setSaving(false)
    load()
  }

  const deposit = async () => {
    if (!showDeposit || !depositForm.amount) return
    setSaving(true)
    const amount = parseFloat(depositForm.amount)
    const delta = depositForm.type === 'deposit' ? amount : -amount
    await Promise.all([
      supabase.from('savings_transactions').insert({
        goal_id: showDeposit.id,
        amount,
        type: depositForm.type,
        note: depositForm.note || null,
        date: new Date().toISOString().split('T')[0],
      }),
      supabase.from('savings_goals').update({
        current_amount: Math.max(0, showDeposit.current_amount + delta),
        updated_at: new Date().toISOString(),
      }).eq('id', showDeposit.id),
    ])
    setDepositForm({ amount: '', type: 'deposit', note: '' })
    setShowDeposit(null)
    setSaving(false)
    load()
  }

  const deleteGoal = async (id: string) => {
    if (!confirm('Удалить цель?')) return
    await supabase.from('savings_goals').update({ is_active: false }).eq('id', id)
    setShowDetail(null)
    load()
  }

  const totalSaved = goals.reduce((a, g) => a + g.current_amount, 0)
  const totalTarget = goals.reduce((a, g) => a + g.target_amount, 0)

  return (
    <div>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 28 }}>
        <div>
          <h1 style={{ fontSize: 28, fontWeight: 700, color: '#e8eaf0', letterSpacing: '-0.5px' }}>Сбережения</h1>
          <p style={{ color: '#7a8499', fontSize: 14, marginTop: 4 }}>Всего накоплено: <strong style={{ color: '#22c55e' }}>{fmt(totalSaved)} ₸</strong> из {fmt(totalTarget)} ₸</p>
        </div>
        <button className="btn-primary" onClick={() => setShowAdd(true)}>+ Новая цель</button>
      </div>

      {/* Goals grid */}
      {goals.length === 0 ? (
        <div className="card" style={{ padding: 40, textAlign: 'center', color: '#7a8499' }}>
          Нет целей. Нажмите &quot;+ Новая цель&quot;
        </div>
      ) : (
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: 16, marginBottom: 24 }}>
          {goals.map(goal => {
            const pct = goal.target_amount > 0 ? Math.min((goal.current_amount / goal.target_amount) * 100, 100) : 0
            const remaining = goal.target_amount - goal.current_amount
            const daysLeft = goal.deadline ? Math.ceil((new Date(goal.deadline).getTime() - Date.now()) / 86400000) : null
            const monthlyNeeded = daysLeft && remaining > 0 ? Math.ceil(remaining / (daysLeft / 30)) : null

            return (
              <div key={goal.id} className="card" style={{ padding: 20, cursor: 'pointer', transition: 'border-color 0.15s', borderColor: '#1e2535' }}
                onClick={() => openDetail(goal)}
                onMouseEnter={e => (e.currentTarget.style.borderColor = goal.color)}
                onMouseLeave={e => (e.currentTarget.style.borderColor = '#1e2535')}
              >
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 12 }}>
                  <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
                    <div style={{ width: 40, height: 40, borderRadius: 10, background: goal.color + '22', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: 20 }}>
                      {goal.icon}
                    </div>
                    <div>
                      <div style={{ fontSize: 14, fontWeight: 600, color: '#e8eaf0' }}>{goal.name}</div>
                      {daysLeft !== null && (
                        <div style={{ fontSize: 11, color: daysLeft < 30 ? '#ef4444' : '#7a8499' }}>
                          {daysLeft > 0 ? `${daysLeft} дней` : 'Срок истёк'}
                        </div>
                      )}
                    </div>
                  </div>
                  <button onClick={e => { e.stopPropagation(); setShowDeposit(goal) }} style={{
                    background: goal.color, border: 'none', borderRadius: 6,
                    padding: '4px 10px', color: 'white', cursor: 'pointer', fontSize: 12, fontWeight: 500,
                  }}>
                    + Пополнить
                  </button>
                </div>

                <div style={{ marginBottom: 8 }}>
                  <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 6 }}>
                    <span style={{ fontSize: 20, fontWeight: 700, color: goal.color, fontFamily: 'monospace' }}>
                      {fmt(goal.current_amount)} ₸
                    </span>
                    {goal.target_amount > 0 && (
                      <span style={{ fontSize: 13, color: '#7a8499', alignSelf: 'flex-end' }}>
                        из {fmt(goal.target_amount)} ₸
                      </span>
                    )}
                  </div>
                  {goal.target_amount > 0 && (
                    <div style={{ background: '#1e2535', borderRadius: 4, height: 8 }}>
                      <div style={{ width: `${pct}%`, height: '100%', borderRadius: 4, background: goal.color, transition: 'width 0.3s' }} />
                    </div>
                  )}
                </div>

                {goal.target_amount > 0 && (
                  <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12, color: '#7a8499', marginTop: 8 }}>
                    <span>{pct.toFixed(0)}% выполнено</span>
                    {monthlyNeeded && <span>~{fmt(monthlyNeeded)} ₸/мес</span>}
                  </div>
                )}
              </div>
            )
          })}
        </div>
      )}

      {/* Add Goal Modal */}
      {showAdd && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.75)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 1000 }}
          onClick={e => e.target === e.currentTarget && setShowAdd(false)}>
          <div className="card" style={{ padding: 28, width: 440 }}>
            <h3 style={{ fontSize: 16, fontWeight: 600, color: '#e8eaf0', marginBottom: 20 }}>Новая цель</h3>

            {/* Icon picker */}
            <div style={{ marginBottom: 14 }}>
              <label style={{ fontSize: 12, color: '#7a8499', display: 'block', marginBottom: 8 }}>Иконка</label>
              <div style={{ display: 'flex', flexWrap: 'wrap', gap: 8 }}>
                {ICONS.map(icon => (
                  <button key={icon} onClick={() => setForm(f => ({ ...f, icon }))} style={{
                    width: 36, height: 36, borderRadius: 8, border: `2px solid ${form.icon === icon ? '#3b5bdb' : '#1e2535'}`,
                    background: form.icon === icon ? '#1e2d5e' : '#1e2535', cursor: 'pointer', fontSize: 18,
                  }}>{icon}</button>
                ))}
              </div>
            </div>

            {/* Color picker */}
            <div style={{ marginBottom: 14 }}>
              <label style={{ fontSize: 12, color: '#7a8499', display: 'block', marginBottom: 8 }}>Цвет</label>
              <div style={{ display: 'flex', gap: 8 }}>
                {COLORS.map(color => (
                  <button key={color} onClick={() => setForm(f => ({ ...f, color }))} style={{
                    width: 28, height: 28, borderRadius: '50%', background: color, border: `3px solid ${form.color === color ? 'white' : 'transparent'}`, cursor: 'pointer',
                  }} />
                ))}
              </div>
            </div>

            <div style={{ marginBottom: 12 }}>
              <label style={{ fontSize: 12, color: '#7a8499', display: 'block', marginBottom: 6 }}>Название *</label>
              <input className="input" placeholder="Напр. Отпуск в Бали" value={form.name} onChange={e => setForm(f => ({ ...f, name: e.target.value }))} autoFocus />
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12, marginBottom: 12 }}>
              <div>
                <label style={{ fontSize: 12, color: '#7a8499', display: 'block', marginBottom: 6 }}>Цель (₸)</label>
                <input className="input" type="number" placeholder="0" value={form.target_amount} onChange={e => setForm(f => ({ ...f, target_amount: e.target.value }))} />
              </div>
              <div>
                <label style={{ fontSize: 12, color: '#7a8499', display: 'block', marginBottom: 6 }}>Дедлайн</label>
                <input className="input" type="date" value={form.deadline} onChange={e => setForm(f => ({ ...f, deadline: e.target.value }))} />
              </div>
            </div>

            <div style={{ marginBottom: 20 }}>
              <label style={{ fontSize: 12, color: '#7a8499', display: 'block', marginBottom: 6 }}>Заметка</label>
              <input className="input" placeholder="Необязательно" value={form.notes} onChange={e => setForm(f => ({ ...f, notes: e.target.value }))} />
            </div>

            <div style={{ display: 'flex', gap: 10 }}>
              <button className="btn-primary" onClick={addGoal} disabled={saving || !form.name} style={{ flex: 1 }}>
                {saving ? 'Сохраняю...' : 'Создать цель'}
              </button>
              <button onClick={() => setShowAdd(false)} style={{ padding: '10px 20px', borderRadius: 8, border: '1px solid #1e2535', background: 'transparent', color: '#7a8499', cursor: 'pointer', fontSize: 14 }}>
                Отмена
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Deposit Modal */}
      {showDeposit && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.75)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 1000 }}
          onClick={e => e.target === e.currentTarget && setShowDeposit(null)}>
          <div className="card" style={{ padding: 28, width: 380 }}>
            <h3 style={{ fontSize: 16, fontWeight: 600, color: '#e8eaf0', marginBottom: 6 }}>
              {showDeposit.icon} {showDeposit.name}
            </h3>
            <p style={{ fontSize: 13, color: '#7a8499', marginBottom: 20 }}>
              Накоплено: {fmt(showDeposit.current_amount)} ₸
            </p>

            <div style={{ display: 'flex', gap: 8, marginBottom: 16 }}>
              {(['deposit', 'withdrawal'] as const).map(t => (
                <button key={t} onClick={() => setDepositForm(f => ({ ...f, type: t }))} style={{
                  flex: 1, padding: '8px 0', borderRadius: 8, border: 'none', cursor: 'pointer', fontSize: 13, fontWeight: 500,
                  background: depositForm.type === t ? (t === 'deposit' ? '#22c55e' : '#ef4444') : '#1e2535',
                  color: depositForm.type === t ? 'white' : '#7a8499',
                }}>
                  {t === 'deposit' ? '+ Пополнить' : '- Снять'}
                </button>
              ))}
            </div>

            <div style={{ marginBottom: 12 }}>
              <label style={{ fontSize: 12, color: '#7a8499', display: 'block', marginBottom: 6 }}>Сумма (₸)</label>
              <input className="input" type="number" placeholder="0" value={depositForm.amount} onChange={e => setDepositForm(f => ({ ...f, amount: e.target.value }))} autoFocus />
            </div>

            <div style={{ marginBottom: 20 }}>
              <label style={{ fontSize: 12, color: '#7a8499', display: 'block', marginBottom: 6 }}>Заметка</label>
              <input className="input" placeholder="Необязательно" value={depositForm.note} onChange={e => setDepositForm(f => ({ ...f, note: e.target.value }))} />
            </div>

            <div style={{ display: 'flex', gap: 10 }}>
              <button className="btn-primary" onClick={deposit} disabled={saving || !depositForm.amount} style={{ flex: 1, background: depositForm.type === 'deposit' ? '#22c55e' : '#ef4444' }}>
                {saving ? 'Сохраняю...' : depositForm.type === 'deposit' ? 'Пополнить' : 'Снять'}
              </button>
              <button onClick={() => setShowDeposit(null)} style={{ padding: '10px 20px', borderRadius: 8, border: '1px solid #1e2535', background: 'transparent', color: '#7a8499', cursor: 'pointer', fontSize: 14 }}>
                Отмена
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Detail Modal */}
      {showDetail && (
        <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.75)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 1000 }}
          onClick={e => e.target === e.currentTarget && setShowDetail(null)}>
          <div className="card" style={{ padding: 28, width: 440, maxHeight: '80vh', overflowY: 'auto' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20 }}>
              <h3 style={{ fontSize: 16, fontWeight: 600, color: '#e8eaf0' }}>{showDetail.icon} {showDetail.name}</h3>
              <div style={{ display: 'flex', gap: 8 }}>
                <button onClick={() => { setShowDeposit(showDetail); setShowDetail(null) }} className="btn-primary" style={{ fontSize: 13, padding: '6px 14px' }}>
                  + Пополнить
                </button>
                <button onClick={() => deleteGoal(showDetail.id)} style={{ background: 'none', border: '1px solid #7f1d1d', borderRadius: 8, padding: '6px 10px', color: '#ef4444', cursor: 'pointer', fontSize: 13 }}>
                  🗑
                </button>
              </div>
            </div>

            {/* Progress */}
            {showDetail.target_amount > 0 && (
              <div style={{ marginBottom: 20 }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 8 }}>
                  <span style={{ fontSize: 24, fontWeight: 700, color: showDetail.color, fontFamily: 'monospace' }}>{fmt(showDetail.current_amount)} ₸</span>
                  <span style={{ fontSize: 14, color: '#7a8499', alignSelf: 'flex-end' }}>из {fmt(showDetail.target_amount)} ₸</span>
                </div>
                <div style={{ background: '#1e2535', borderRadius: 6, height: 10, marginBottom: 8 }}>
                  <div style={{ width: `${Math.min((showDetail.current_amount / showDetail.target_amount) * 100, 100)}%`, height: '100%', borderRadius: 6, background: showDetail.color }} />
                </div>
                <div style={{ fontSize: 12, color: '#7a8499' }}>
                  Осталось накопить: {fmt(Math.max(0, showDetail.target_amount - showDetail.current_amount))} ₸
                  {showDetail.deadline && ` · до ${new Date(showDetail.deadline).toLocaleDateString('ru')}`}
                </div>
              </div>
            )}

            {showDetail.notes && (
              <div style={{ background: '#1e2535', borderRadius: 8, padding: 12, marginBottom: 16, fontSize: 13, color: '#a0aec0' }}>
                💬 {showDetail.notes}
              </div>
            )}

            {/* Transaction history */}
            <h4 style={{ fontSize: 13, fontWeight: 600, color: '#7a8499', marginBottom: 12, textTransform: 'uppercase', letterSpacing: '0.05em' }}>История</h4>
            {txHistory.length === 0 ? (
              <div style={{ fontSize: 13, color: '#4a5568', textAlign: 'center', padding: 16 }}>Нет операций</div>
            ) : (
              txHistory.map(tx => (
                <div key={tx.id} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '8px 0', borderBottom: '1px solid #1e2535' }}>
                  <div>
                    <div style={{ fontSize: 13, color: '#e8eaf0' }}>{tx.note || (tx.type === 'deposit' ? 'Пополнение' : 'Снятие')}</div>
                    <div style={{ fontSize: 11, color: '#7a8499' }}>{tx.date}</div>
                  </div>
                  <span style={{ fontSize: 14, fontWeight: 600, color: tx.type === 'deposit' ? '#22c55e' : '#ef4444', fontFamily: 'monospace' }}>
                    {tx.type === 'deposit' ? '+' : '-'}{fmt(tx.amount)} ₸
                  </span>
                </div>
              ))
            )}

            <button onClick={() => setShowDetail(null)} style={{ marginTop: 16, width: '100%', padding: '10px', borderRadius: 8, border: '1px solid #1e2535', background: 'transparent', color: '#7a8499', cursor: 'pointer', fontSize: 14 }}>
              Закрыть
            </button>
          </div>
        </div>
      )}
    </div>
  )
}
